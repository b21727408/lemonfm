#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"
source "$ROOT/tooling/tools.sh"

GRADLE="$ROOT/gradlew"
FLUTTER_VERSION="3.47.2"

resolve_flutter() {
  if [[ -n "${LEMON_FLUTTER_BIN:-}" ]]; then
    printf '%s\n' "$LEMON_FLUTTER_BIN"
    return
  fi
  local windows_cache="${USERPROFILE:-}/.cache/lemon/flutter-$FLUTTER_VERSION/flutter/bin/flutter.bat"
  if [[ -f "$windows_cache" ]]; then
    printf '%s\n' "$windows_cache"
    return
  fi
  if command -v flutter >/dev/null 2>&1; then
    command -v flutter
    return
  fi
  echo "Flutter $FLUTTER_VERSION is required; set LEMON_FLUTTER_BIN to its executable" >&2
  exit 69
}

FLUTTER=""
DART=""

verify_flutter() {
  if [[ -z "$FLUTTER" ]]; then
    FLUTTER="$(resolve_flutter)"
    if [[ "$FLUTTER" == *.bat ]]; then
      DART="${FLUTTER%flutter.bat}dart.bat"
    else
      DART="${FLUTTER%flutter}dart"
    fi
  fi
  local version
  version="$("$FLUTTER" --version --machine)"
  grep -Eq '"frameworkVersion"[[:space:]]*:[[:space:]]*"3\.47\.2"' <<<"$version" || {
    echo "Expected Flutter $FLUTTER_VERSION; LEMON_FLUTTER_BIN resolved to $FLUTTER" >&2
    exit 69
  }
  grep -Eq '"dartSdkVersion"[[:space:]]*:[[:space:]]*"3\.13\.2"' <<<"$version" || {
    echo "Flutter $FLUTTER_VERSION must contain Dart 3.13.2" >&2
    exit 69
  }
}

flutter_pub_get() {
  verify_flutter
  "$FLUTTER" pub get --enforce-lockfile
}

flutter_pub_refresh() {
  verify_flutter
  "$FLUTTER" pub get
}

dart_sources=(
  apps
  packages/admin_api_client
  packages/api_client
  packages/foundation
  packages/lemon_lints
  packages/lemon_ui
  packages/telemetry
  packages/realtime_client
  packages/secure_store
  packages/features
)

architecture() {
  "$GRADLE" --quiet :tooling:architecture:run --args="$*"
}

flutter_fast() {
  architecture validate
  flutter_pub_get
  "$DART" format --output=none --set-exit-if-changed "${dart_sources[@]}"
  "$DART" analyze --fatal-infos --fatal-warnings
  "$DART" run packages/lemon_lints/tool/rule_fixture_test.dart
}

flutter_tests() {
  flutter_pub_get
  "$FLUTTER" test packages/lemon_ui/test
  "$DART" run packages/lemon_lints/tool/rule_fixture_test.dart
}

contract_roundtrip() {
  verify_flutter
  "$GRADLE" :backend:generateFixtureContractBindings
  local manifest="$ROOT/contracts/fixtures/generated/fixture-contracts.json"
  local public_client="$ROOT/backend/build/openapi/fixture-publicv1-client"
  local admin_client="$ROOT/backend/build/openapi/fixture-adminv1-client"
  mkdir -p "$public_client/tool" "$admin_client/tool"
  sed 's/name: contract_fixture_client/name: contract_fixture_public_client/' \
    "$ROOT/contracts/fixtures/http/dart/pubspec.fixture.yaml" >"$public_client/pubspec.yaml"
  sed 's/name: contract_fixture_client/name: contract_fixture_admin_client/' \
    "$ROOT/contracts/fixtures/http/dart/pubspec.fixture.yaml" >"$admin_client/pubspec.yaml"
  cp "$ROOT/contracts/fixtures/http/dart/public_roundtrip.dart.txt" "$public_client/tool/roundtrip.dart"
  cp "$ROOT/contracts/fixtures/http/dart/admin_roundtrip.dart.txt" "$admin_client/tool/roundtrip.dart"
  (
    cd "$public_client"
    "$DART" pub get
    "$DART" run build_runner build
    "$DART" run tool/roundtrip.dart "$manifest"
  )
  (
    cd "$admin_client"
    "$DART" pub get
    "$DART" run build_runner build
    "$DART" run tool/roundtrip.dart "$manifest"
  )
}

openapi_compatibility() {
  local oasdiff base_ref specification status
  oasdiff="$(resolve_pinned_tool oasdiff)"
  set +e
  "$oasdiff" breaking --fail-on ERR --color never \
    contracts/fixtures/oasdiff/baseline.yaml contracts/fixtures/oasdiff/breaking.yaml >/dev/null
  status=$?
  set -e
  if [[ "$status" -ne 1 ]]; then
    echo "oasdiff permanent breaking-change fixture did not fail with exit 1 (got $status)" >&2
    exit 70
  fi
  base_ref="${LEMON_API_BASE_REF:-origin/main}"
  for specification in public-v1.yaml admin-v1.yaml; do
    if git cat-file -e "$base_ref:contracts/http/$specification" 2>/dev/null; then
      "$oasdiff" breaking --fail-on ERR --color never \
        "$base_ref:contracts/http/$specification" "contracts/http/$specification"
    else
      echo "$specification: no authored contract at $base_ref; compatibility baseline begins after merge"
    fi
  done
}

gitleaks_check() {
  local gitleaks fixture_dir status
  gitleaks="$(resolve_pinned_tool gitleaks)"
  fixture_dir="${LEMON_TOOL_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/lemon/tools}/gitleaks-self-test"
  mkdir -p "$fixture_dir"
  local suffix
  suffix="$(printf '%s' 'lemon-gitleaks-detector-fixture' | sha256_digest | cut -c1-36)"
  printf 'token = "ghp_%s"\n' "$suffix" >"$fixture_dir/fixture.txt"
  set +e
  "$gitleaks" dir --no-banner --no-color "$fixture_dir/fixture.txt" >/dev/null 2>&1
  status=$?
  set -e
  rm -f "$fixture_dir/fixture.txt"
  if [[ "$status" -ne 1 ]]; then
    echo "Gitleaks permanent detector fixture did not fail with exit 1 (got $status)" >&2
    exit 70
  fi
  "$gitleaks" git --redact --no-banner --no-color .
}

dependency_integrity() {
  flutter_pub_get
  "$GRADLE" :backend:dependencies :tooling:architecture:dependencies >/dev/null
  "$GRADLE" -p build-logic dependencies >/dev/null
  git diff --exit-code -- '**/gradle.lockfile' pubspec.lock '**/verification-metadata.xml'
}

compare_generated_path() {
  local expected_root="$1" actual_root="$2" relative="$3"
  local expected="$expected_root/$relative" actual="$actual_root/$relative"
  if [[ ! -e "$expected" && ! -e "$actual" ]]; then
    return 0
  fi
  if [[ ! -e "$expected" || ! -e "$actual" ]] || ! diff -r -q "$expected" "$actual" >/dev/null; then
    echo "Generated artifact drift: $relative differs; run ./lemon generate" >&2
    return 1
  fi
}

verify_generated_drift_detector() {
  if compare_generated_path \
    "$ROOT/tooling/generated-drift-fixtures/current" \
    "$ROOT/tooling/generated-drift-fixtures/stale" \
    sentinel.txt >/dev/null 2>&1; then
    echo "Generated drift permanent stale-output fixture did not fail" >&2
    return 70
  fi
}

copy_check_workspace() {
  local destination="$1" relative
  while IFS= read -r -d '' relative; do
    [[ -f "$ROOT/$relative" ]] || continue
    case "$relative" in
      gradle/wrapper/gradle-wrapper.jar) ;;
      *.7z|*.aab|*.apk|*.dmg|*.gz|*.ipa|*.jar|*.rar|*.tar|*.tgz|*.zip) continue ;;
    esac
    mkdir -p "$destination/$(dirname "$relative")"
    cp -p "$ROOT/$relative" "$destination/$relative"
  done < <(git -C "$ROOT" ls-files -z --cached --others --exclude-standard)
}

generated_drift_check() {
  verify_generated_drift_detector
  verify_flutter
  local sandbox status=0
  sandbox="$(mktemp -d "${TMPDIR:-/tmp}/lemon-generated-drift.XXXXXX")"
  copy_check_workspace "$sandbox"
  set +e
  (cd "$sandbox" && LEMON_FLUTTER_BIN="$FLUTTER" ./lemon generate)
  status=$?
  set -e
  if [[ "$status" -ne 0 ]]; then
    echo "Isolated generation failed while checking generated drift" >&2
  else
    local path
    for path in \
      AGENTS.md \
      architecture/generated \
      apps/mobile/android/app/src/main/res/values/lemon_generated_colors.xml \
      apps/mobile/ios/Runner/Assets.xcassets/LemonBg0.colorset \
      apps/moderation/web/lemon_generated_colors.css \
      apps/moderation/web/manifest.json \
      apps/widgetbook/web/lemon_generated_colors.css \
      apps/widgetbook/web/manifest.json \
      backend/src/generated \
      backend/src/main/java \
      backend/src/test/resources/generated \
      config/forbidden-apis/signatures.txt \
      contracts/fixtures/generated \
      contracts/generated-bindings.sha256.json \
      packages/admin_api_client/lib \
      packages/api_client/lib \
      packages/lemon_lints/lib/src/generated \
      packages/lemon_ui/lib/src/generated \
      tooling/generated; do
      compare_generated_path "$ROOT" "$sandbox" "$path" || status=1
    done
  fi
  case "$sandbox" in
    "${TMPDIR:-/tmp}"/lemon-generated-drift.*) rm -rf -- "$sandbox" ;;
    *) echo "Refusing to remove unexpected drift sandbox: $sandbox" >&2; return 70 ;;
  esac
  [[ "$status" -eq 0 ]] || return "$status"
  echo "generated artifacts: current (isolated non-mutating regeneration)"
}

is_build_infrastructure_path() {
  case "$1" in
    build-logic/*|gradle/*|gradlew|gradlew.bat|settings.gradle.kts|gradle.properties|.github/workflows/*|.github/actions/*|tooling/architecture/*|tooling/*.sh|lemon|lemon.cmd|compose.yaml|apps/mobile/android/*.gradle.kts|apps/mobile/android/gradle.properties|architecture/modules.schema.json)
      return 0
      ;;
    *) return 1 ;;
  esac
}

has_build_infrastructure_path() {
  local path
  while IFS= read -r path; do
    [[ -z "$path" ]] || ! is_build_infrastructure_path "$path" || return 0
  done
  return 1
}

is_build_infrastructure_title() {
  [[ "$1" =~ ^build: ]] || [[ "$1" =~ ^chore\(build\): ]]
}

verify_pr_classification_policy() {
  local build_paths feature_paths
  build_paths="$(<"$ROOT/tooling/pr-classification-fixtures/build-paths.txt")"
  feature_paths="$(<"$ROOT/tooling/pr-classification-fixtures/feature-paths.txt")"
  if ! has_build_infrastructure_path <<<"$build_paths"; then
    echo "PR classification permanent build-path fixture was not recognized" >&2
    return 70
  fi
  if has_build_infrastructure_path <<<"$feature_paths"; then
    echo "PR classification permanent feature-path fixture was misclassified" >&2
    return 70
  fi
  if is_build_infrastructure_title "feat: add profile screen"; then
    echo "PR classification permanent feature-title fixture was misclassified" >&2
    return 70
  fi
  if ! is_build_infrastructure_title "build: update Gradle policy" ||
    ! is_build_infrastructure_title "chore(build): scaffold repository"; then
    echo "PR classification permanent build-title fixture was rejected" >&2
    return 70
  fi
}

pr_classification_check() {
  verify_pr_classification_policy
  local title="${LEMON_PR_TITLE:-}" base_ref="${LEMON_PR_BASE_REF:-origin/main}" changed_paths
  if [[ -z "$title" ]]; then
    echo "PR classification: permanent fixtures passed (PR metadata unavailable locally)"
    return
  fi
  changed_paths="$(git diff --name-only "$base_ref"...HEAD)"
  if has_build_infrastructure_path <<<"$changed_paths" && ! is_build_infrastructure_title "$title"; then
    echo "Build-infrastructure changes require a PR title beginning with 'build:' or 'chore(build):'" >&2
    return 70
  fi
  echo "PR classification: valid"
}

repository_security() {
  verify_checksum_helper
  architecture "check policy"
  dependency_integrity
  gitleaks_check
}

contracts_check() {
  architecture validate
  "$GRADLE" :backend:contractsCheck :backend:test --tests fm.lemon.contractfixture.ContractFixtureResponseTest
  architecture "contract-manifest check"
  contract_roundtrip
  openapi_compatibility
  architecture "migration-append-only ${LEMON_API_BASE_REF:-origin/main}"
}

build_smoke() {
  architecture validate
  flutter_pub_get
  "$GRADLE" :backend:bootJar
  local targets="${LEMON_BUILD_TARGETS:-}"
  if [[ -z "$targets" ]]; then
    if [[ "$(uname -s)" == Darwin ]]; then
      targets="ios,web"
    else
      targets="android,web"
    fi
  fi
  if [[ ",$targets," == *,android,* ]]; then
    (cd "$ROOT/apps/mobile" && "$FLUTTER" build apk --debug)
  fi
  if [[ ",$targets," == *,ios,* ]]; then
    (cd "$ROOT/apps/mobile" && "$FLUTTER" build ios --simulator --no-codesign)
  fi
  if [[ ",$targets," == *,web,* ]]; then
    (cd "$ROOT/apps/moderation" && "$FLUTTER" build web)
    (cd "$ROOT/apps/widgetbook" && "$FLUTTER" build web)
  fi
}

case "${1:-}" in
  generate)
    architecture generate
    "$GRADLE" :backend:generateJooq :backend:generateContractBindings
    flutter_pub_refresh
    (cd packages/api_client && "$DART" run build_runner build)
    (cd packages/admin_api_client && "$DART" run build_runner build)
    "$DART" format "${dart_sources[@]}"
    architecture "contract-manifest generate"
    ;;
  check)
    scope="${3:-all}"
    [[ "${2:-}" == "--scope" ]] || scope="all"
    case "$scope" in
      pr-classification) pr_classification_check ;;
      policy|generated)
        [[ "$scope" != policy ]] || verify_pr_classification_policy
        architecture "check $scope"
        [[ "$scope" != policy ]] || "$GRADLE" :tooling:architecture:spotlessCheck
        ;;
      backend-fast)
        architecture validate
        "$GRADLE" :tooling:architecture:spotlessCheck :backend:check
        ;;
      flutter-fast) flutter_fast ;;
      postgres-integration)
        architecture validate
        "$GRADLE" :backend:postgresIntegrationTest
        ;;
      contracts) contracts_check ;;
      repository-security) repository_security ;;
      build-smoke) build_smoke ;;
      all)
        verify_pr_classification_policy
        architecture "check all"
        generated_drift_check
        "$GRADLE" :tooling:architecture:spotlessCheck :backend:contractsCheck :backend:check :backend:postgresIntegrationTest
        repository_security
        contracts_check
        flutter_fast
        flutter_tests
        build_smoke
        ;;
      *) echo "unknown check scope: $scope" >&2; exit 64 ;;
    esac
    ;;
  test)
    architecture validate
    "$GRADLE" test :backend:postgresIntegrationTest
    flutter_tests
    contract_roundtrip
    ;;
  fix)
    architecture generate
    "$GRADLE" :backend:spotlessApply :tooling:architecture:spotlessApply
    verify_flutter
    "$DART" format "${dart_sources[@]}"
    ;;
  dev)
    docker compose up --detach --wait postgres
    SPRING_FLYWAY_ENABLED=true "$GRADLE" :backend:bootRun
    ;;
  *) echo "usage: ./lemon {check|test|fix|generate|dev} [--scope <scope>]" >&2; exit 64 ;;
esac
