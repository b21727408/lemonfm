#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

GRADLE="$ROOT/gradlew"

architecture() {
  "$GRADLE" --quiet :tooling:architecture:run --args="$*"
}

case "${1:-}" in
  generate)
    architecture generate
    "$GRADLE" :backend:generateJooq
    ;;
  check)
    scope="${3:-all}"
    if [[ "${2:-}" != "--scope" ]]; then
      scope="all"
    fi
    case "$scope" in
      policy|generated)
        architecture "check $scope"
        ;;
      backend-fast)
        architecture validate
        "$GRADLE" :backend:check
        ;;
      postgres-integration)
        architecture validate
        "$GRADLE" :backend:postgresIntegrationTest
        ;;
      all)
        architecture "check all"
        "$GRADLE" :backend:check :backend:postgresIntegrationTest
        ;;
      *)
        echo "unknown check scope: $scope" >&2
        exit 64
        ;;
    esac
    ;;
  test)
    architecture validate
    "$GRADLE" test :backend:postgresIntegrationTest
    ;;
  fix)
    architecture generate
    "$GRADLE" spotlessApply
    dart format .
    ;;
  dev)
    docker compose up -d postgres
    "$GRADLE" :backend:bootRun
    ;;
  *)
    echo "usage: ./lemon {check|test|fix|generate|dev} [--scope <scope>]" >&2
    exit 64
    ;;
esac
